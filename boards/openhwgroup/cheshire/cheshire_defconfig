CONFIG_INCLUDE_RESET_VECTOR=y
CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_NS16550_ACCESS_WORD_ONLY=y
CONFIG_CONSOLE_HANDLER=y
CONFIG_XIP=n
# enable the SBI support
CONFIG_RISCV_SBI_BOOT=y
# Run zephyr in Supervisor mode
CONFIG_RISCV_S_MODE=y
CONFIG_RISCV_MACHINE_TIMER=n
CONFIG_RISCV_SUPERVISOR_TIMER=y
# options that have to be disabled by now
CONFIG_USERSPACE=n
CONFIG_THREAD_MONITOR=n